# Copia este archivo como ".env" (en la misma carpeta) y llena tus llaves.
# NUNCA subas el .env a GitHub: ya está en .gitignore.

# ---------- Acceso ----------
# En tu PC puedes dejarla vacía (con ENTORNO=local no se pide).
# En Render es obligatoria: inventa una clave larga; la app te la pedirá una vez en cada dispositivo.
APP_CLAVE=
# "local" permite usar la app sin clave en tu computadora. En Render déjalo en "produccion".
ENTORNO=local
NOMBRE_USUARIO=Ricardo
ZONA_HORARIA=America/Mexico_City

# ---------- Cerebro ----------
# "claude" (recomendado, de pago ~$1-2 USD/mes con Haiku) o "gemini" (100% gratis).
# Si eliges claude y se acaban los créditos, Gemini responde automáticamente.
ORQUESTADOR=claude
ANTHROPIC_API_KEY=
MODELO_CLAUDE=claude-haiku-5-5

# ---------- Gemini (gratis desde Google AI Studio) ----------
GEMINI_API_KEY=
MODELO_GEMINI=gemini-3.5-flash-lite
MODELO_GEMINI_ORQUESTADOR=gemini-3.8-flash
# Si un modelo está saturado, JARVIS reintenta y luego prueba estos (en orden):
MODELOS_GEMINI_RESPALDO=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# ---------- Voz ----------
# "gemini" = voz natural generada por Gemini (gratis).  "navegador" = voz del sistema.
VOZ_MOTOR=gemini
VOZ_GEMINI=Charon
VOZ_ESTILO=sereno, elegante y preciso, como un mayordomo refinado
# Primero el modelo de voz más rápido; si tarda, está saturado o llega a su límite, se prueban los demás:
MODELO_TTS=gemini-3.8-flash-lite-tts
MODELOS_TTS_RESPALDO=gemini-3.8-flash-tts,gemini-3.1-flash-tts-preview

# ---------- Investigación ----------
# "gratis" = Tavily busca + Gemini resume ($0).  "google" = Gemini busca en Google (requiere facturación).
INVESTIGACION_MODO=gratis
TAVILY_API_KEY=

# ---------- Notion ----------
NOTION_TOKEN=
NOTION_VERSION=2026-03-11
# Ya están llenos con tus páginas (los IDs no son secretos: sin el token no sirven).
NOTION_OBJETIVOS_PAGE_ID=cdcf919711ba419891bc4634a9eab0a6
NOTION_CALENDARIO_DATABASE_ID=b7b1b527efef42929021415ecbc00347
NOTION_CALENDARIO_DATA_SOURCE_ID=
# Página donde JARVIS crea notas nuevas (resúmenes, investigaciones). Crea una página "JARVIS" y pega su enlace o ID.
NOTION_NOTAS_PADRE_ID=
